TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_TOKEN=
TELEGRAM_SESSION_DIR=storage/sessions
TELEGRAM_CHANNEL_ID=-1001100109226
# Basic group id; when set, reposts go there instead of the channel (memery is still written)
# TELEGRAM_TEST_CHAMBER_ID=
TELEGRAM_SEARCH_TIMEZONE=Asia/Yekaterinburg
TELEGRAM_SEARCH_DATE_START=2017-11-05
TELEGRAM_MEMERY_FILE=storage/memery.json
# Comma-separated author signatures to skip (the bot's current and past names)
TELEGRAM_IGNORE_AUTHOR=День в истории,Альцгеймер
# Needed where Telegram is blocked, e.g. on a dev machine in Russia
# TELEGRAM_PROXY=socks5://127.0.0.1:2080
